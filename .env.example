TRACKER_DOMAIN=kx7qpa.example.com
SITE_ORIGIN=https://www.example.com
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Default on: cookieless page_view and allowed-event pings when denied or a supported banner is undecided.
# Includes visitor IP, browser User-Agent and cleaned event parameters; not anonymous. Off disables all pings.
# Fixed event-param allowlist: value, currency, URL/referrer and Visitor Verdict fields; no items/custom data. Basic Consent Mode sites: set off.
DENIED_PINGS=on
# /d only: full (default), truncated (IPv4 /24, IPv6 /48; mapped IPv4 uses /24), or off (omit _uip).
# IP off makes Google geolocate the collector server; truncation reduces geographic precision.
DENIED_PING_IP=full
# /d only: on (default) forwards browser UA; off sends fixed User-Agent: unknown, suppressing fetch defaults.
# Off removes browser/device dimensions from UA; verification still uses incoming IP/headers.
DENIED_PING_USER_AGENT=on
# Optional. Set to eu to send through Google's EU collection endpoint (region1.google-analytics.com).
GA4_REGION=
# Generated by install.sh. For manual setup use: openssl rand -hex 32
COOKIE_SECRET=
# Must cover website AND tracker; default is SITE_ORIGIN hostname without leading www.
COOKIE_DOMAIN=example.com
TRACKED_EVENTS=view_item_list,select_item,view_item,add_to_cart,remove_from_cart,view_cart,begin_checkout,add_shipping_info,add_payment_info,purchase,refund,generate_lead,sign_up,login,search

# Optional. Label events with server verification evidence; never filters events.
AGENT_VERIFICATION=off
# Default off: label obvious bot UAs and forward their events. on restores legacy dropping.
FILTER_OBVIOUS_BOTS=off
# Additional query parameter names to retain in URLs (comma-separated, exact case). Empty by default.
# Set vvp to keep a test marker. Do not allow personal data.
KEEP_QUERY_PARAMS=
# Optional: defaults to AGENT_VERIFICATION. off restores 204 and disables browser echo.
# VERDICT_ECHO=on

# Optional. One log line per /e request: event name, HTTP status and delivery outcome.
LOG_EVENTS=off
# Optional Node listener settings (defaults shown); keep Compose listener ports unchanged.
# PORT=3000
# HOST=0.0.0.0
# GA4_API_SECRET is ignored and triggers a startup warning; all events use /g/collect.
# Omit TRACKED_EVENTS for defaults; an empty TRACKED_EVENTS= fails startup.

# Optional detailed /health access token. Leave unset to disable token protection; empty fails startup.
# HEALTH_TOKEN=replace-with-a-nonempty-secret
# Optional comma-separated trusted proxy peers/CIDRs; production default: loopback,uniquelocal.
# Empty explicitly disables forwarding-header trust. Use the actual container peer for Docker.
# TRUST_PROXY=loopback,uniquelocal

# Opt-in unsigned UA claims outside complete operator IP ranges (requires AGENT_VERIFICATION).
FLAG_SPOOFED_CLAIMS=off
