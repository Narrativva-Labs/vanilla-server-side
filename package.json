{
  "name": "vanilla-server-side",
  "version": "0.4.4",
  "private": true,
  "description": "Independent, self-hosted parallel web analytics",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/client/index.ts --bundle --format=iife --global-name=VanillaGA --target=es2022 --minify --outfile=dist/public/s.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "dev": "npm run build && npm start",
    "demo": "npm run build --silent && node scripts/demo.mjs",
    "format": "prettier --write src tests scripts",
    "format:check": "prettier --check src tests scripts"
  },
  "dependencies": {
    "fastify": "^5.6.2",
    "visitor-verdict-server": "file:vendor/visitor-verdict-server-0.7.5.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "author": "Franti\u0161ek Bujnovsk\u00fd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Narrativva-Labs/vanilla-server-side.git"
  }
}
