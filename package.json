{
  "name": "vanilla-server-side",
  "version": "0.1.0",
  "private": true,
  "description": "Independent, self-hosted parallel web analytics",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/client/index.ts --bundle --format=iife --global-name=VanillaGA --target=es2022 --minify --outfile=dist/public/s.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "dev": "npm run build && npm start",
    "demo": "npm run build --silent && node scripts/demo.mjs",
    "verify:mp": "npm run build --silent && node --env-file-if-exists=.env scripts/verify-mp.mjs",
    "format": "prettier --write src tests scripts",
    "format:check": "prettier --check src tests scripts"
  },
  "dependencies": {
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "author": "František Bujnovský",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Narrativva-Labs/vanilla-server-side.git"
  }
}
