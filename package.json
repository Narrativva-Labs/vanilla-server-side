{
  "name": "vanilla-server-side",
  "version": "0.1.0",
  "private": true,
  "description": "Independent, self-hosted parallel web analytics",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/client/index.ts --bundle --format=iife --global-name=VanillaGA --target=es2022 --minify --outfile=dist/public/s.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "dev": "npm run build && npm start"
  },
  "dependencies": {
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "author": "František Bujnovský",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Narrativva-Labs/vanilla-server-side.git"
  }
}
